{
	"schemaVersion": 1,
	"id": "limlib",
	"version": "${version}",
	"name": "Liminal Library",
	"description": "A library for liminal mods",
	"authors": [
		"LudoCrypt"
	],
	"contact": {
		"homepage": "https://github.com/LudoCrypt/Liminal-Library/wiki",
		"issues": "https://github.com/LudoCrypt/Liminal-Library/issues",
		"sources": "https://github.com/LudoCrypt/Liminal-Library"
	},
	"icon": "assets/limlib/icon.png",
	"license": "LGPL-3.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.dimdev.limlib.impl.Limlib"
		],
		"client": [
			"org.dimdev.limlib.impl.LimlibClient"
		],
		"fabric-datagen": [
      "org.dimdev.limlib.datagen.DataGenInitalizer"
    ]
	},
	"mixins": [
		"limlib.mixins.json"
	],
	"accessWidener": "limlib.accesswidener",
	"custom": {
		"modmenu": {
			"badges": [
				"library"
			]
		}
	},
	"depends": {
		"fabricloader": "*",
		"minecraft": "1.21.1"
	}
}
